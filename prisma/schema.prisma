generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  Int                 @id @default(autoincrement())
  nama                String              @db.VarChar(100)
  email               String              @unique @db.VarChar(150)
  password            String              @db.VarChar(255)
  role                Role                @default(ORG_ADMIN)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  last_seen_update_id Int?
  documentations      Documentation[]     @relation("DocCreatedBy")
  dokumentasi_foto    DokumentasiFoto[]   @relation("FotoCreatedBy")
  email_import_logs   EmailImportLog[]    @relation("AdminImportLogs")
  email_logs          EmailLog[]          @relation("AdminEmailLogs")
  exp_logs_given      ExpLog[]
  log_aktivitas       LogAktivitas[]
  organizations       OrganizationAdmin[]
  updates_created     SystemUpdate[]      @relation("UpdateCreatedBy")
  chat_wawancara      ChatWawancara[]
  hasil_wawancara     HasilWawancara[]       @relation("Interviewer")
  overridden_hasils   HasilWawancara[]       @relation("Overrider")
  progression_executed SchoolYearProgression[] @relation("ProgressionExecutedBy")
  progression_reverted SchoolYearProgression[] @relation("ProgressionRevertedBy")
  materi_hari_ini      MateriHariIni[]

  @@index([created_at])
  @@map("users")
}

model Organization {
  id                Int                 @id @default(autoincrement())
  nama              String              @db.VarChar(100)
  slug              String              @unique @db.VarChar(100)
  tipe              String?             @db.VarChar(50)
  category          String              @default("Ekstrakurikuler") @db.VarChar(50)
  school_origin     String              @default("SMK Airlangga") @db.VarChar(100)
  status            String              @default("Aktif") @db.VarChar(20)
  deskripsi         String?
  hari_pertemuan    String?             @db.VarChar(20)
  lokasi            String?             @db.VarChar(100)
  waktu_mulai       String?             @db.VarChar(10)
  waktu_selesai     String?             @db.VarChar(10)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  achievements      Achievement[]
  announcements     Announcement[]
  attendance        Attendance[]
  cash_expenses     CashExpense[]
  cash_transactions CashTransaction[]
  documentations    Documentation[]
  dokumentasi_foto  DokumentasiFoto[]
  email_templates   EmailTemplate[]
  exp_logs          ExpLog[]
  materials         Material[]
  members           Member[]
  admins            OrganizationAdmin[]
  registrations     Registration[]
  schedules         Schedule[]

  @@map("organizations")
}

model OrganizationAdmin {
  id              Int          @id @default(autoincrement())
  user_id         Int
  organization_id Int
  created_at      DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, organization_id])
  @@map("organization_admins")
}

model Member {
  id                Int                 @id @default(autoincrement())
  organization_id   Int
  nis               String?             @db.VarChar(20)
  name              String              @db.VarChar(100)
  email             String?             @db.VarChar(150)
  class             String?             @db.VarChar(20)
  level             Int                 @default(1)
  exp               Int                 @default(0)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  jabatan           String?             @default("Anggota") @db.VarChar(100)
  status            String              @default("ACTIVE") @db.VarChar(20)
  attendance        Attendance[]
  cash_transactions CashTransaction[]
  exp_logs          ExpLog[]
  achievements      MemberAchievement[]
  organization      Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([nis])
  @@index([name])
  @@map("members")
}

model Attendance {
  id              Int          @id @default(autoincrement())
  organization_id Int
  member_id       Int
  date            DateTime     @db.Date
  status          String       @db.VarChar(20)
  cash_amount     Int          @default(0)
  notes           String?
  created_at      DateTime     @default(now())
  member          Member       @relation(fields: [member_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([member_id, date])
  @@index([organization_id])
  @@index([date])
  @@map("attendance")
}

model CashTransaction {
  id              Int          @id @default(autoincrement())
  organization_id Int
  member_id       Int
  amount          Int
  description     String       @db.VarChar(255)
  created_at      DateTime     @default(now())
  type            String       @default("INCOME") @db.VarChar(10)
  member          Member       @relation(fields: [member_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([member_id])
  @@map("cash_transactions")
}

model CashExpense {
  id              Int          @id @default(autoincrement())
  organization_id Int
  amount          Int
  description     String       @db.VarChar(255)
  date            DateTime     @default(now())
  created_at      DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("cash_expenses")
}

model Registration {
  id              Int                @id @default(autoincrement())
  organization_id Int
  name            String             @db.VarChar(100)
  class           String             @db.VarChar(50)
  major           String             @db.VarChar(100)
  email           String             @db.VarChar(100)
  nisn            String?            @db.VarChar(20)
  status          RegistrationStatus @default(MENUNGGU)
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  organization    Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([email, organization_id])
  @@index([organization_id])
  @@index([status])
  @@map("registrations")
}

model LogAktivitas {
  id              Int      @id @default(autoincrement())
  user_id         Int
  user_nama       String   @db.VarChar(100)
  aksi            AksiLog
  tabel           String   @db.VarChar(50)
  record_id       String?  @db.VarChar(50)
  deskripsi       String
  data_lama       Json?
  data_baru       Json?
  ip_address      String?  @db.VarChar(45)
  created_at      DateTime @default(now())
  organization_id Int?
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([organization_id])
  @@index([created_at])
  @@map("log_aktivitas")
}

model Documentation {
  id              Int          @id @default(autoincrement())
  title           String       @db.VarChar(200)
  description     String?
  category        String       @db.VarChar(100)
  photos          Json
  created_at      DateTime     @default(now())
  created_by      Int
  type            String       @db.VarChar(50)
  date_taken      DateTime     @default(now())
  organization_id Int
  updated_at      DateTime     @updatedAt
  deletedAt       DateTime?           @map("deleted_at")
  creator         User         @relation("DocCreatedBy", fields: [created_by], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("documentations")
}

model DokumentasiFoto {
  id              Int              @id @default(autoincrement())
  judul           String           @db.VarChar(150)
  image_url       String           @db.VarChar(255)
  public_id       String?          @db.VarChar(100)
  organisasi_type OrganisasiType?
  media_type      String?          @db.VarChar(20)
  tanggal         DateTime         @db.Date
  created_by      Int
  created_at      DateTime         @default(now())
  description     String?
  organization_id Int
  creator         User             @relation("FotoCreatedBy", fields: [created_by], references: [id])
  organization    Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("dokumentasi_foto")
}

model Announcement {
  id              Int          @id @default(autoincrement())
  organization_id Int
  title           String       @db.VarChar(255)
  content         String
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("announcements")
}

model Material {
  id              Int          @id @default(autoincrement())
  organization_id Int
  title           String       @db.VarChar(255)
  content         String
  date            DateTime     @db.Date
  created_at      DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("materials")
}

model Schedule {
  id              Int          @id @default(autoincrement())
  organization_id Int
  title           String       @db.VarChar(255)
  date            DateTime     @db.Date
  start_time      String?      @db.VarChar(10)
  location        String?      @db.VarChar(200)
  is_mandatory    Boolean      @default(false)
  created_at      DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("schedules")
}

model EmailTemplate {
  id              Int          @id @default(autoincrement())
  subject         String
  created_at      DateTime     @default(now())
  body_template   String
  email_type      String       @db.VarChar(50)
  is_active       Boolean      @default(true)
  organization_id Int
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, email_type])
  @@map("email_templates")
}

model ExpLog {
  id              Int          @id @default(autoincrement())
  member_id       Int
  organization_id Int
  admin_id        Int
  exp_before      Int
  exp_after       Int
  amount          Int
  reason          String       @db.VarChar(500)
  created_at      DateTime     @default(now())
  admin           User         @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  member          Member       @relation(fields: [member_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([member_id])
  @@index([organization_id])
  @@index([created_at])
  @@map("exp_logs")
}

model Achievement {
  id              Int                 @id @default(autoincrement())
  organization_id Int
  icon            String              @db.VarChar(100)
  name            String              @db.VarChar(150)
  description     String
  exp_reward      Int
  created_at      DateTime            @default(now())
  organization    Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  members         MemberAchievement[]

  @@index([organization_id])
  @@map("achievements")
}

model MemberAchievement {
  id             Int         @id @default(autoincrement())
  member_id      Int
  achievement_id Int
  earned_at      DateTime    @default(now())
  achievement    Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
  member         Member      @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@unique([member_id, achievement_id])
  @@map("member_achievements")
}

model MasterKelas {
  id            Int      @id @default(autoincrement())
  kelas_nama    String   @unique @db.VarChar(10)
  kelas_singkat String   @db.VarChar(5)
  tingkat       String?  @db.VarChar(20)
  created_at    DateTime @default(now())

  @@map("master_kelas")
}

model MasterKejuruan {
  id               Int        @id @default(autoincrement())
  kejuruan_kode    String     @unique @db.VarChar(20)
  kejuruan_nama    String     @db.VarChar(100)
  kejuruan_singkat String     @db.VarChar(20)
  skill_group      SkillGroup
  created_at       DateTime   @default(now())

  @@map("master_kejuruan")
}

model SystemUpdate {
  id          Int        @id @default(autoincrement())
  version     String     @db.VarChar(50)
  content     String
  update_type UpdateType @default(update)
  created_at  DateTime   @default(now())
  created_by  Int
  creator     User       @relation("UpdateCreatedBy", fields: [created_by], references: [id])

  @@index([created_at])
  @@map("system_updates")
}

model EmailLog {
  id              Int       @id @default(autoincrement())
  subject         String    @db.VarChar(255)
  content         String
  admin_id        Int
  status          String    @default("sent") @db.VarChar(20)
  error_message   String?
  sent_at         DateTime?
  created_at      DateTime  @default(now())
  recipient_email String    @db.VarChar(150)
  recipient_name  String    @db.VarChar(100)
  admin           User      @relation("AdminEmailLogs", fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@map("email_logs")
}

model EmailImportLog {
  id           Int      @id @default(autoincrement())
  filename     String   @db.VarChar(255)
  admin_id     Int
  errors       String
  status       String   @default("completed") @db.VarChar(20)
  created_at   DateTime @default(now())
  failure_rows Int
  success_rows Int
  total_rows   Int
  admin        User     @relation("AdminImportLogs", fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@map("email_import_logs")
}

model EmailSetting {
  id           Int      @id @default(autoincrement())
  email        String   @db.VarChar(150)
  updated_at   DateTime @updatedAt
  app_password String   @db.VarChar(255)

  @@map("email_settings")
}

enum Role {
  administrator
  organization_admin
  admin_programming
  admin_english
  admin_osis_mpk
  SUPER_ADMIN
  ORG_ADMIN
}

enum RegistrationStatus {
  MENUNGGU
  DITERIMA
  DITOLAK
  CALON
}

enum SkillGroup {
  SKARLA
  SKAKES
}

enum AksiLog {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}


enum UpdateType {
  update
  pengumuman
  perbaikan
}

enum OrganisasiType {
  programming
  english
  osis
  mpk
}

model SesiWawancara {
  id              Int                 @id @default(autoincrement())
  status          String              @default("INACTIVE")
  organisasi_type String              @db.VarChar(20)
  jadwal_mulai    DateTime?
  jadwal_selesai  DateTime?
  finalized_at    DateTime?
  locked_at       DateTime?
  created_by      Int?
  creator         User?               @relation(fields: [created_by], references: [id])
  created_at      DateTime            @default(now())
  antrian         AntrianWawancara[]
  chat            ChatWawancara[]
  qr_codes        QrWawancara[]

  @@index([status])
  @@index([organisasi_type])
  @@map("sesi_wawancara")
}

model QrWawancara {
  id          Int      @id @default(autoincrement())
  token       String   @unique @db.VarChar(100)
  aktif       Boolean  @default(true)
  valid_from  DateTime
  valid_until DateTime
  sesi_id     Int?
  created_by  Int?
  creator     User?   @relation(fields: [created_by], references: [id])
  created_at  DateTime @default(now())
  antrian     AntrianWawancara[]
  sesi        SesiWawancara? @relation(fields: [sesi_id], references: [id], onDelete: SetNull)

  @@map("qr_wawancara")
}

model AntrianWawancara {
  id              Int      @id @default(autoincrement())
  sesi_id         Int
  qr_id           Int?
  nama            String   @db.VarChar(100)
  kelas           String   @db.VarChar(50)
  nomor_antrian   Int
  scan_token      String?  @db.VarChar(100)
  ip_address      String?  @db.VarChar(45)
  ip_status       String   @default("TIDAK_DIKETAHUI")
  ip_country      String?  @db.VarChar(100)
  ip_isp          String?  @db.VarChar(100)
  gps_lat         Float?
  gps_lng         Float?
  jarak_meter     Float?
  status_validasi String   @default("SAH")
  alasan_validasi String?
  user_agent      String?  @db.VarChar(255)
  status          String   @default("MENUNGGU")
  created_at      DateTime @default(now())
  
  sesi            SesiWawancara   @relation(fields: [sesi_id], references: [id], onDelete: Cascade)
  qr              QrWawancara?    @relation(fields: [qr_id], references: [id], onDelete: SetNull)
  hasil_wawancara HasilWawancara?

  @@unique([sesi_id, nomor_antrian])
  @@index([sesi_id])
  @@map("antrian_wawancara")
}

model ChatWawancara {
  id         Int      @id @default(autoincrement())
  sesi_id    Int
  sender_id  Int
  pesan      String
  created_at DateTime @default(now())
  
  sesi       SesiWawancara @relation(fields: [sesi_id], references: [id], onDelete: Cascade)
  sender     User          @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([sesi_id])
  @@map("chat_wawancara")
}

model HasilWawancara {
  id              Int      @id @default(autoincrement())
  antrian_id      Int      @unique
  interviewer_id  Int
  keterangan      String   @db.VarChar(20)
  hasil           String   @db.VarChar(20)
  persentase      Float
  catatan         String?
  override_by     Int?
  override_alasan String?
  override_at     DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  antrian         AntrianWawancara @relation(fields: [antrian_id], references: [id], onDelete: Cascade)
  interviewer     User             @relation("Interviewer", fields: [interviewer_id], references: [id])
  overrider       User?            @relation("Overrider", fields: [override_by], references: [id])

  @@index([interviewer_id])
  @@map("hasil_wawancara")
}

model SchoolYearProgression {
  id               Int                   @id @default(autoincrement())
  batch_id         String                @unique @default(uuid())
  school_year_from String                @db.VarChar(20)
  school_year_to   String                @db.VarChar(20)
  status           String                @db.VarChar(20)
  total_promoted   Int                   @default(0)
  total_graduated  Int                   @default(0)
  executed_by      Int
  executed_at      DateTime              @default(now())
  reverted_at      DateTime?
  reverted_by      Int?
  notes            String?               @db.Text
  logs             ClassProgressionLog[]
  admin            User                  @relation("ProgressionExecutedBy", fields: [executed_by], references: [id])
  reverter         User?                 @relation("ProgressionRevertedBy", fields: [reverted_by], references: [id])

  @@index([executed_at])
  @@map("school_year_progression")
}

model ClassProgressionLog {
  id             Int                   @id @default(autoincrement())
  progression_id Int
  student_id     Int
  student_type   String                @db.VarChar(20)
  old_class      String                @db.VarChar(20)
  new_class      String                @db.VarChar(20)
  action         String                @db.VarChar(20)
  
  progression    SchoolYearProgression @relation(fields: [progression_id], references: [id], onDelete: Cascade)

  @@index([progression_id])
  @@map("class_progression_logs")
}

model Siswa {
  id              Int       @id @default(autoincrement())
  nis             String?   @db.VarChar(20)
  nama            String    @db.VarChar(100)
  kelas           String?   @db.VarChar(20)
  ekskul          String    @db.VarChar(50)
  status          String?   @default("ACTIVE") @db.VarChar(20)
  graduation_date DateTime?
  created_by      Int?
  creator         User?     @relation(fields: [created_by], references: [id])
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  pengelompokan   PengelompokanKegiatan[]
  absensi         Absensi[]

  @@index([nis])
  @@index([nama])
  @@map("siswa")
}

model AnggotaOsis {
  id              Int       @id @default(autoincrement())
  nis             String?   @db.VarChar(20)
  nama            String    @db.VarChar(100)
  kelas           String?   @db.VarChar(20)
  ekskul          String    @db.VarChar(50)
  status          String?   @default("ACTIVE") @db.VarChar(20)
  graduation_date DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  absensi         AbsensiOrganisasi[] @relation("AbsensiOsis")

  @@index([nis])
  @@map("anggota_osis")
}

model AnggotaMpk {
  id              Int       @id @default(autoincrement())
  nis             String?   @db.VarChar(20)
  nama            String    @db.VarChar(100)
  kelas           String?   @db.VarChar(20)
  ekskul          String    @db.VarChar(50)
  status          String?   @default("ACTIVE") @db.VarChar(20)
  graduation_date DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  absensi         AbsensiOrganisasi[] @relation("AbsensiMpk")

  @@index([nis])
  @@map("anggota_mpk")
}

model JadwalKegiatan {
  id          Int            @id @default(autoincrement())
  judul       String         @db.VarChar(255)
  tanggal     DateTime       @db.Date
  waktu       String?        @db.VarChar(10)
  lokasi      String?        @db.VarChar(200)
  keterangan  String?
  organisasi  String?        @db.VarChar(50) // Simplified as String
  wajib_hadir Boolean        @default(false)
  created_by  Int
  creator     User          @relation(fields: [created_by], references: [id])
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  @@index([organisasi])
  @@index([tanggal])
  @@map("jadwal_kegiatan")
}

model Kegiatan {
  id              Int                     @id @default(autoincrement())
  nama_kegiatan   String                  @db.VarChar(255)
  tipe            String                  @db.VarChar(50)
  tanggal         DateTime?               @db.Date
  organization_id Int?
  created_at      DateTime                @default(now())
  pengelompokan   PengelompokanKegiatan[]
  organization    Organization?           @relation(fields: [organization_id], references: [id])

  @@index([tipe])
  @@index([organization_id])
  @@map("kegiatan")
}

model PengelompokanKegiatan {
  id            Int       @id @default(autoincrement())
  kegiatan_id   Int
  siswa_id      Int
  organisasi    String    @db.VarChar(50)
  sub_kategori  String?
  created_at    DateTime  @default(now())
  kegiatan      Kegiatan  @relation(fields: [kegiatan_id], references: [id], onDelete: Cascade)
  siswa         Siswa     @relation(fields: [siswa_id], references: [id], onDelete: Cascade)

  @@unique([kegiatan_id, siswa_id])
  @@index([kegiatan_id])
  @@index([siswa_id])
  @@map("pengelompokan_kegiatan")
}

model MateriHariIni {
  id          Int              @id @default(autoincrement())
  judul       String           @db.VarChar(255)
  deskripsi   String
  tanggal     DateTime         @db.Date
  organisasi  OrganisasiType
  notulen     String?
  lokasi      String?          @db.VarChar(200)
  created_by  Int
  created_at  DateTime         @default(now())
  creator     User             @relation(fields: [created_by], references: [id])

  @@index([organisasi])
  @@index([tanggal])
  @@map("materi_hari_ini")
}

model AbsensiOrganisasi {
  id               Int          @id @default(autoincrement())
  anggota_osis_id  Int?
  anggota_mpk_id   Int?
  organisasi_type  OrganisasiType
  tanggal          DateTime     @db.Date
  status           String       @db.VarChar(20)
  uang_kas         Int          @default(0)
  keterangan       String?
  created_by       Int
  updated_by       Int?
  creator          User         @relation(fields: [created_by], references: [id])
  updater          User?        @relation(fields: [updated_by], references: [id])
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  anggota_osis     AnggotaOsis? @relation("AbsensiOsis", fields: [anggota_osis_id], references: [id])
  anggota_mpk      AnggotaMpk?  @relation("AbsensiMpk", fields: [anggota_mpk_id], references: [id])

  @@unique([anggota_osis_id, tanggal])
  @@unique([anggota_mpk_id, tanggal])
  @@index([organisasi_type])
  @@index([tanggal])
  @@map("absensi_organisasi")
}

model Absensi {
  id          Int      @id @default(autoincrement())
  siswa_id    Int
  tanggal     DateTime @db.Date
  status      String   @db.VarChar(20)
  uang_kas    Int      @default(0)
  created_by  Int?
  updated_by  Int?
  creator     User?    @relation(fields: [created_by], references: [id])
  updater     User?    @relation(fields: [updated_by], references: [id])
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  siswa       Siswa    @relation(fields: [siswa_id], references: [id], onDelete: Cascade)

  @@unique([siswa_id, tanggal])
  @@index([tanggal])
  @@map("absensi")
}

model PengeluaranKas {
  id              Int              @id @default(autoincrement())
  organisasi_type OrganisasiType
  tanggal         DateTime         @db.Date
  nominal         Int
  keterangan      String?
  created_by      Int?
  creator         User?            @relation(fields: [created_by], references: [id])
  created_at      DateTime         @default(now())

  @@index([organisasi_type])
  @@index([tanggal])
  @@map("pengeluaran_kas")
}

model RegistrationEskul {
  id              Int        @id @default(autoincrement())
  organization_id Int
  nama_peserta    String     @db.VarChar(100)
  kelas           String     @db.VarChar(50)
  kejuruan        String     @db.VarChar(100)
  email_gmail     String     @db.VarChar(100)
  nisn            String?    @db.VarChar(20)
  qr_token        String?
  qr_token_expired DateTime?
  status          String     @default("MENUNGGU") @db.VarChar(20)
  accept_reason   String?
  reject_reason   String?
  accepted_by     Int?
  accepted_at     DateTime?
  rejected_by     Int?
  rejected_at     DateTime?
  email_sent_at   DateTime?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([email_gmail, organization_id])
  @@index([organization_id])
  @@map("registration_eskul")
}

model RegistrationOsisMpk {
  id              Int        @id @default(autoincrement())
  organization_id Int
  nama_peserta    String     @db.VarChar(100)
  kelas           String     @db.VarChar(50)
  kejuruan        String     @db.VarChar(100)
  email_gmail     String     @db.VarChar(100)
  nisn            String?    @db.VarChar(20)
  qr_token        String?
  qr_token_expired DateTime?
  status          String     @default("CALON") @db.VarChar(20)
  accept_reason   String?
  reject_reason   String?
  accepted_by     Int?
  accepted_at     DateTime?
  rejected_by     Int?
  rejected_at     DateTime?
  email_sent_at   DateTime?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([email_gmail, organization_id])
  @@index([organization_id])
  @@map("registration_osis_mpk")
}

model Pencapaian {
  id            Int                  @id @default(autoincrement())
  nama          String               @db.VarChar(150)
  icon          String               @db.VarChar(100)
  deskripsi     String?
  exp_reward    Int                  @default(0)
  organisasi    String?              @db.VarChar(50)
  created_at    DateTime             @default(now())
  siswa         SiswaPencapaian[]

  @@index([organisasi])
  @@map("pencapaian")
}

model SiswaPencapaian {
  id             Int         @id @default(autoincrement())
  pencapaian_id  Int
  siswa_id       Int
  earned_at      DateTime    @default(now())
  pencapaian     Pencapaian  @relation(fields: [pencapaian_id], references: [id], onDelete: Cascade)
  siswa          Siswa       @relation(fields: [siswa_id], references: [id], onDelete: Cascade)

  @@unique([pencapaian_id, siswa_id])
  @@map("siswa_pencapaian")
}
